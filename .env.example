# Copy to .env (deploy/install.sh does this for you) and adjust.

# Public hostname served by Caddy. Use a real domain pointing to the VPS for automatic HTTPS,
# or ":80" to serve plain HTTP on the server IP.
DOMAIN=:80
# Public URL, used in notification links (optional)
APP_URL=

# Initial administrator (created on first start only, when the database is empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Session signing secret. Leave empty to auto-generate and persist in data/.jwt_secret
JWT_SECRET=

# Load demo users/requests/resources on first start (never use in production)
SEED_DEMO=false
DEMO_PASSWORD=

# Optional: POST every notification as JSON {text,userId,requestId,link} (Teams/Slack/n8n/Power Automate HTTP trigger)
NOTIFY_WEBHOOK_URL=

MAX_UPLOAD_MB=10
# Change if ports 80/443 are already used on the VPS
HTTP_PORT=80
HTTPS_PORT=443
